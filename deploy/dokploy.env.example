# Paste into the application's Environment tab in Dokploy. Do not commit filled-in values.
# The exact public origin people open, with no trailing slash. Sign-in messages and the origin check on every write use it.
APP_ORIGIN=https://ripburn.cards
# Traefik sits in front of the app.
TRUST_PROXY_HOPS=1
# The Internal Connection URL of the Postgres service you create in Dokploy (docs/DOKPLOY.md, step 1).
DATABASE_URL=
# Keep false until `npm run check` is all green and the wallets are funded. With MAINNET_ENABLED=false and
# no SOLANA_RPC_URL, the site is a public practice site with play money.
MAINNET_ENABLED=false
# The wallet that can open /admin.
OWNER_WALLET=

# Two different wallets, both different from any other project's. Base58 secret key, or a quoted JSON array of 64 bytes.
# OPS buys packs and forwards cards; TREASURY is the dev wallet: the coin's creator-fee recipient, repays and burns.
OPS_PRIVATE_KEY=
TREASURY_PRIVATE_KEY=
# Our coin's mint (what gets bought back and burned), its decimals, and its ticker without the $ (e.g. RIP).
MEMECOIN_MINT=
MEMECOIN_DECIMALS=6
COIN_SYMBOL=RIP
JUPITER_API_KEY=

# A paid mainnet RPC (Helius, Triton, QuickNode) that supports DAS getAsset.
SOLANA_RPC_URL=
DAS_RPC_URL=
COLLECTOR_CRYPT_API_KEY=
COLLECTOR_CRYPT_PAYMENT_WALLET=GachaNgyXTU3zFogQ8Z5jR2BLXs8215X2AtEH18VxJq3
CARDS_MINT=CARDSccUMFKoPRZxt5vt3ksUbxEFEcnZ3H2pd3dKxYjp
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
GAS_RESERVE_SOL=0.05
SLIPPAGE_BPS=100
