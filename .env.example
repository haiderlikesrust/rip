# Copy to .env. With no .env at all the app runs in practice mode (fake balances, mocked
# Collector Crypt). For a real deployment, fill in every REQUIRED line below.
# Admin -> "Launch readiness" lists anything still missing.

# ── Server ────────────────────────────────────────────────────────────────
# REQUIRED: true turns on real signing and spending.
MAINNET_ENABLED=false
# 0.0.0.0 in Docker or on a VPS; 127.0.0.1 locally.
HOST=127.0.0.1
API_PORT=4100
# REQUIRED: the exact public URL people open (scheme + host, no trailing slash).
# Write requests from any other origin are refused, and https makes the session cookie secure.
APP_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the app on a private network (nginx, Caddy, Traefik): usually 1.
TRUST_PROXY_HOPS=0
# REQUIRED for mainnet: Postgres. Without it the app uses embedded Postgres in .data (local only).
# DATABASE_URL=postgres://user:password@host:5432/ripburn

# ── Coin and owner ────────────────────────────────────────────────────────
# REQUIRED: our pump.fun coin's mint. It is what gets bought back and burned, and holding it makes a wallet a holder.
MEMECOIN_MINT=
# pump.fun coins have 6 decimals.
MEMECOIN_DECIMALS=6
# The ticker shown on the site, without the $.
COIN_SYMBOL=RIP
# REQUIRED: the wallet that can open /admin.
OWNER_WALLET=

# ── Wallets (backend only: never put these in a VITE_ variable or commit them) ──
# Base58 secret key or a JSON array of 64 bytes. OPS and TREASURY must be different wallets.
# REQUIRED. OPS: receives user payments, buys and opens packs, forwards cards. Keep only working funds here.
# Needs SOL for fees and a USDC token account.
OPS_PRIVATE_KEY=
# REQUIRED. TREASURY (the dev wallet): the coin's pump.fun creator-fee recipient (or a fee-sharing shareholder).
# Holds $CARDS (the burn fund) and USDC (the repay reserve), pays repays and runs the buyback-and-burns.
# Needs SOL for fees, a USDC account, and some starting USDC for the first holder repays.
TREASURY_PRIVATE_KEY=

# ── Providers ─────────────────────────────────────────────────────────────
# REQUIRED: a paid mainnet RPC (Helius, Triton, QuickNode). The public RPC is too rate-limited.
SOLANA_RPC_URL=
# Optional: a DAS-capable RPC for card names and images. Defaults to SOLANA_RPC_URL.
DAS_RPC_URL=
# REQUIRED: from https://portal.jup.ag. Used for $CARDS → coin burns and $CARDS → USDC refills.
JUPITER_API_KEY=
# Optional: a Collector Crypt partner key, if you have one.
COLLECTOR_CRYPT_API_KEY=
# REQUIRED (default shown): Collector Crypt's payment wallet. Confirm it with them before launch.
COLLECTOR_CRYPT_PAYMENT_WALLET=GachaNgyXTU3zFogQ8Z5jR2BLXs8215X2AtEH18VxJq3

# ── Defaults you normally keep ────────────────────────────────────────────
CARDS_MINT=CARDSccUMFKoPRZxt5vt3ksUbxEFEcnZ3H2pd3dKxYjp
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
GAS_RESERVE_SOL=0.05
SLIPPAGE_BPS=100
